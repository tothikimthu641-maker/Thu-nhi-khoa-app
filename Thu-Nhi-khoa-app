<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Nhi Khoa Lâm Sàng - Tra Cứu & Tính Nhanh Liều Thuốc PICU</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Alpine.js -->
  <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
</head>
<body class="bg-slate-900 text-slate-100 min-h-screen flex flex-col justify-between"
      x-data="drugApp()">

  <!-- HEADER -->
  <header class="bg-gradient-to-r from-blue-600 via-indigo-600 to-purple-600 p-4 shadow-lg sticky top-0 z-50">
    <div class="max-w-5xl mx-auto flex justify-between items-center">
      <div class="flex items-center gap-2">
        <span class="text-yellow-300 text-2xl">❤️</span>
        <h1 class="text-xl font-extrabold text-white tracking-wide">Nhi Khoa Lâm Sàng - PICU/NICU</h1>
      </div>
      <span class="text-xs bg-blue-800/60 px-2.5 py-1 rounded-full text-blue-200 border border-blue-400/30 font-medium">Full Datasets v4.0 (TB, TTM, TMC)</span>
    </div>
  </header>

  <!-- MAIN CONTAINER -->
  <main class="max-w-5xl mx-auto w-full p-4 flex-1 space-y-6">

    <!-- KHU VỰC TÍNH NHANH BƠM TIÊM ĐIỆN & TRUYỀN DỊCH -->
    <section class="bg-slate-800/90 border border-slate-700 rounded-2xl p-5 shadow-xl backdrop-blur">
      <h2 class="text-lg font-bold text-amber-400 flex items-center gap-2 mb-4">
        ⚡ Tính Nhanh Lâm Sàng (Pha BTĐ / Truyền Liên Tục)
      </h2>
      
      <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
        <!-- Cân nặng -->
        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1">Cân nặng bé (kg):</label>
          <input type="number" step="0.1" x-model.number="weight" placeholder="VD: 10" 
                 class="w-full bg-slate-900 border border-slate-600 rounded-xl px-3 py-2 text-white focus:outline-none focus:border-amber-400">
        </div>

        <!-- Chọn Thuốc -->
        <div class="md:col-span-2">
          <label class="block text-xs font-semibold text-slate-300 mb-1">Chọn Thuốc Cần Tính:</label>
          <select x-model="selectedDrugKey" @change="onDrugChange()"
                  class="w-full bg-slate-900 border border-slate-600 rounded-xl px-3 py-2 text-white focus:outline-none focus:border-amber-400">
            <template x-for="(drug, key) in drugs" :key="key">
              <option :value="key" x-text="`[${drug.category}] ${drug.name}`"></option>
            </template>
          </select>
        </div>

        <!-- Thể tích dịch pha -->
        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1">Thể tích pha (ml):</label>
          <input type="number" step="1" x-model.number="volume" 
                 class="w-full bg-slate-900 border border-slate-600 rounded-xl px-3 py-2 text-white focus:outline-none focus:border-amber-400">
        </div>
      </div>

      <!-- THANH ĐIỀU CHỈNH 2 CHIỀU: LIỀU <--> TỐC ĐỘ TRUYỀN (ML/H) -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-4 pt-4 border-t border-slate-700">
        <div class="bg-slate-900/60 p-3.5 rounded-xl border border-slate-700">
          <label class="block text-xs font-semibold text-blue-300 mb-1" x-text="'Liều mong muốn (' + currentDrug.unit + '):'"></label>
          <div class="flex items-center gap-2">
            <input type="number" step="0.01" x-model.number="targetDose" @input="calculateRateFromDose()"
                   class="w-full bg-slate-950 border border-slate-600 rounded-lg px-3 py-2 text-white font-bold text-amber-400 focus:outline-none focus:border-blue-400">
            <span class="text-xs text-slate-400 whitespace-nowrap" x-text="currentDrug.unit"></span>
          </div>
          <p class="text-xs text-slate-400 mt-2" x-text="`➔ Tốc độ bơm tiêm điện cần chạy: <strong class='text-emerald-400 font-bold'>${calculatedRateMlH} ml/giờ</strong>`"></p>
        </div>

        <div class="bg-slate-900/60 p-3.5 rounded-xl border border-slate-700">
          <label class="block text-xs font-semibold text-emerald-300 mb-1">Tự do chỉnh Tốc độ truyền (ml/giờ):</label>
          <div class="flex items-center gap-2">
            <input type="number" step="0.1" x-model.number="customRateMlH" @input="calculateDoseFromRate()"
                   class="w-full bg-slate-950 border border-slate-600 rounded-lg px-3 py-2 text-white font-bold text-emerald-400 focus:outline-none focus:border-emerald-400">
            <span class="text-xs text-slate-400 whitespace-nowrap">ml/giờ</span>
          </div>
          <p class="text-xs text-slate-400 mt-2" x-text="`➔ Liều thực tế bé đang nhận: <strong class='text-amber-400 font-bold'>${calculatedActualDose} ${currentDrug.unit}</strong>`"></p>
        </div>
      </div>

      <!-- KẾT QUẢ PHA LÂM SÀNG -->
      <div class="mt-4 p-4 bg-amber-950/40 border border-amber-500/30 rounded-xl space-y-2">
        <div class="text-sm font-semibold text-amber-300 flex items-center gap-2">
          📋 Hướng Dẫn Y Lệnh Pha Thuốc & Đường Dùng:
        </div>
        <div class="text-sm text-slate-200 grid grid-cols-1 md:grid-cols-2 gap-2 pt-1">
          <div class="bg-slate-900/80 p-2.5 rounded-lg border border-slate-700">
            <span class="text-slate-400 block text-xs">Lượng thuốc nguyên chất cần lấy:</span>
            <span class="text-lg font-extrabold text-amber-400" x-text="calculatedMg + ' mg'"></span>
          </div>
          <div class="bg-slate-900/80 p-2.5 rounded-lg border border-slate-700">
            <span class="text-slate-400 block text-xs">Đường dùng & Cách pha:</span>
            <span class="text-xs font-semibold text-emerald-300 block" x-text="'Đường dùng: ' + currentDrug.route"></span>
            <span class="text-xs text-white mt-1 block" x-text="mixingInstructionText"></span>
          </div>
        </div>
      </div>
    </section>

    <!-- TRA CỨU TẤT CẢ CÁC THUỐC TRONG FILE EXCEL -->
    <section class="bg-slate-800/90 border border-slate-700 rounded-2xl p-5 shadow-xl">
      <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-3 mb-4">
        <h2 class="text-lg font-bold text-blue-400 flex items-center gap-2">
          📚 Tra Cứu Toàn Bộ Danh Mục Thuốc (Hiển thị chi tiết TB, TTM, TMC)
        </h2>
      </div>

      <!-- BỘ LỌC CHUYÊN MỤC & THANH TÌM KIẾM -->
      <div class="flex flex-col md:flex-row gap-3 mb-4">
        <div class="flex flex-wrap gap-1.5 flex-1">
          <template x-for="cat in categories" :key="cat.id">
            <button @click="selectedCategory = cat.id"
                    :class="selectedCategory === cat.id ? 'bg-blue-600 text-white font-bold border-blue-500' : 'bg-slate-900 text-slate-300 border-slate-700 hover:bg-slate-700'"
                    class="px-3 py-1.5 rounded-lg text-xs border transition" x-text="cat.name">
            </button>
          </template>
        </div>
        <div class="w-full md:w-64">
          <input type="text" x-model="searchQuery" placeholder="Tìm tên thuốc, chỉ định..." 
                 class="w-full bg-slate-900 border border-slate-600 rounded-xl px-3 py-1.5 text-sm text-white focus:outline-none focus:border-blue-400">
        </div>
      </div>

      <!-- DANH SÁCH THUỐC HIỂN THỊ DẠNG THẺ -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 max-h-[550px] overflow-y-auto pr-1">
        <template x-for="(drug, key) in filteredDrugs" :key="key">
          <div class="bg-slate-900/90 border border-slate-700 hover:border-blue-500/50 rounded-xl p-4 space-y-2.5 transition">
            <div class="flex justify-between items-start border-b border-slate-800 pb-2">
              <div>
                <h3 class="text-base font-bold text-blue-300" x-text="drug.name"></h3>
                <p class="text-xs text-slate-400" x-text="'Hàm lượng: ' + drug.concentration"></p>
              </div>
              <span class="bg-blue-950 text-blue-300 text-[10px] px-2 py-0.5 rounded-full border border-blue-800 font-medium" x-text="drug.category"></span>
            </div>

            <!-- HIỂN THỊ ĐƯỜNG DÙNG NỔI BẬT (TB, TTM, TMC) -->
            <div class="bg-emerald-950/40 border border-emerald-500/30 px-3 py-1.5 rounded-lg flex items-center gap-2">
              <span class="text-xs font-bold text-emerald-400 uppercase tracking-wide">Đường dùng:</span>
              <span class="text-xs font-semibold text-emerald-200" x-text="drug.route"></span>
            </div>

            <div class="text-xs space-y-1.5">
              <p><strong class="text-slate-400">Cơ chế / Thụ thể:</strong> <span class="text-slate-200" x-text="drug.receptor"></span></p>
              <p><strong class="text-slate-400">Chỉ định chính:</strong> <span class="text-slate-200" x-text="drug.indication"></span></p>
              <div class="bg-slate-800/60 p-2 rounded border border-slate-700/60">
                <p><strong class="text-amber-400">Liều dùng & Cách pha:</strong> <span class="text-slate-200" x-text="drug.doseRange"></span></p>
                <p class="text-slate-400 mt-1" x-text="'Dung môi tương hợp: ' + drug.diluent"></p>
              </div>
            </div>

            <button @click="selectDrugForCalc(key)" class="w-full mt-2 bg-blue-600/20 hover:bg-blue-600/40 text-blue-300 text-xs py-1.5 rounded-lg border border-blue-500/30 font-medium transition">
              ⚡ Chọn tính nhanh liều này
            </button>
          </div>
        </template>
      </div>
    </section>

  </main>

  <!-- FOOTER -->
  <footer class="bg-slate-950 p-4 border-t border-slate-800 text-center text-xs text-slate-500">
    Nhi Khoa Lâm Sàng - PICU/NICU Toolkit & Drug Reference
  </footer>

