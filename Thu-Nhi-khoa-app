            diluent: "Pha loãng với NaCl 0.9% đủ 3-4 ml"
          },
          budesonide_kd: {
            name: "Budesonide (Pulmicort) dung dịch khí dung",
            concentration: "0.5mg/2ml hoặc 0.25mg/2ml",
            category: "Hô hấp / Khí dung",
            unit: "mg/liều",
            defaultDose: 0.5,
            route: "Phun khí dung qua mặt nạ",
            receptor: "Corticosteroid khí dung kháng viêm tại chỗ",
            indication: "Phù thanh quản cấp, cơn hen phế quản nặng.",
            doseRange: "0.5 - 1 mg/liều phun khí dung.",
            diluent: "Pha loãng với NaCl 0.9% vừa đủ"
          },
          paracetamol: {
            name: "Paracetamol truyền tĩnh mạch",
            concentration: "1000mg/100ml (10mg/ml)",
            category: "Điện giải & Khác",
            unit: "mg/kg/liều",
            defaultDose: 15.0,
            route: "Truyền tĩnh mạch (TTM) trong 15 phút",
            receptor: "Ức chế tổng hợp Prostaglandin thần kinh trung ương",
            indication: "Hạ sốt, giảm đau từ nhẹ đến trung bình.",
            doseRange: "15 mg/kg/liều mỗi 6 giờ.",
            diluent: "Dịch truyền sẵn có"
          },
          calcium_gluconat: {
            name: "Calcium Gluconate 10%",
            concentration: "1g/10ml (10%)",
            category: "Điện giải & Khác",
            unit: "ml/kg/liều",
            defaultDose: 0.5,
            route: "Tiêm mạch chậm (TMC) dưới monitor ECG / Truyền tĩnh mạch (TTM)",
            receptor: "Bổ sung ion Canxi cấp cứu",
            indication: "Hạ canxi máu có triệu chứng, tăng Kali máu bảo vệ cơ tim.",
            doseRange: "0.5 - 1 ml/kg/liều (Pha loãng tỷ lệ 1:1 với D5W, truyền chậm > 10 phút).",
            diluent: "D5W"
          }
        },

        get currentDrug() {
          return this.drugs[this.selectedDrugKey] || this.drugs['adrenalin'];
        },

        onDrugChange() {
          this.targetDose = this.currentDrug.defaultDose;
          this.calculateRateFromDose();
        },

        selectDrugForCalc(key) {
          this.selectedDrugKey = key;
          this.targetDose = this.currentDrug.defaultDose;
          this.calculateRateFromDose();
          window.scrollTo({ top: 0, behavior: 'smooth' });
        },

        get calculatedMg() {
          if (!this.weight || !this.targetDose) return "0";
          let mg = 0;
          if (this.currentDrug.unit.includes("mcg/kg/phút")) {
            mg = (this.targetDose * this.weight * 60 * this.volume) / 1000;
          } else if (this.currentDrug.unit.includes("mcg/kg/giờ")) {
            mg = (this.targetDose * this.weight * this.volume) / 1000;
          } else if (this.currentDrug.unit.includes("mg/kg/giờ")) {
            mg = this.targetDose * this.weight * this.volume;
          } else {
            mg = (this.targetDose * this.weight * 60 * this.volume) / 1000;
          }
          return mg.toFixed(2);
        },

        calculateRateFromDose() {
          this.customRateMlH = 1.0;
        },

        get calculatedRateMlH() {
          return this.customRateMlH.toFixed(1);
        },

        calculateDoseFromRate() {
          let mgTotal = parseFloat(this.calculatedMg);
          if (!this.volume || this.volume <= 0) return 0;
          let mgPerMl = mgTotal / this.volume;
          
          if (this.currentDrug.unit.includes("mcg/kg/phút")) {
            if (this.weight > 0) {
              let actual = (mgPerMl * this.customRateMlH * 1000) / (this.weight * 60);
              return actual.toFixed(2);
            }
          }
          return (mgPerMl * this.customRateMlH).toFixed(2);
        },

        get calculatedActualDose() {
          return this.calculateDoseFromRate();
        },

        get mixingInstructionText() {
          let mg = this.calculatedMg;
          return `Lấy ${mg} mg ${this.currentDrug.name} + ${this.currentDrug.diluent} vừa đủ ${this.volume} ml.`;
        },

        get filteredDrugs() {
          let query = this.searchQuery.toLowerCase().trim();
          let cat = this.selectedCategory;

          let result = {};
          for (let key in this.drugs) {
            let drug = this.drugs[key];
            let matchCat = (cat === 'all' || drug.category === cat);
            let matchQuery = !query || 
                             drug.name.toLowerCase().includes(query) || 
                             drug.indication.toLowerCase().includes(query) ||
                             drug.receptor.toLowerCase().includes(query) ||
                             drug.route.toLowerCase().includes(query);

            if (matchCat && matchQuery) {
              result[key] = drug;
            }
          }
          return result;
        }
      }
    }
  </script>
