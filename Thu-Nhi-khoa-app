<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nhi Khoa Lâm Sàng - Offline Ready</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Alpine.js để xử lý tìm kiếm và bộ lọc động -->
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
</head>
<body class="bg-slate-900 text-slate-100 min-h-screen flex flex-col justify-between" x-data="app()">

    <!-- HEADER -->
    <header class="bg-gradient-to-r from-blue-900 via-indigo-900 to-slate-900 p-4 border-b border-blue-800 shadow-lg">
        <div class="max-w-4xl mx-auto flex justify-between items-center">
            <div>
                <h1 class="text-xl font-bold flex items-center gap-2">
                    <span class="text-pink-500">❤️</span> Nhi Khoa Lâm Sàng
                </h1>
                <p class="text-xs text-blue-300">Giao bệnh chính xác • Kiểm soát an toàn • Vững vàng phác đồ</p>
            </div>
            <div class="text-right">
                <span class="text-xs bg-emerald-600 px-2 py-1 rounded font-mono">OFFLINE READY</span>
            </div>
        </div>
    </header>

    <!-- MAIN CONTENT -->
    <main class="max-w-4xl mx-auto p-4 flex-grow w-full space-y-4">
        
        <!-- Ô TÌM KIẾM & BỘ LỌC TAG -->
        <div class="bg-slate-800 p-3 rounded-xl border border-slate-700 shadow">
            <div class="relative">
                <input type="text" x-model="search" placeholder="Tìm kiếm dược chất, phác đồ, triệu chứng (VD: Caffeine, Phản vệ...)" 
                       class="w-full bg-slate-900 border border-slate-700 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:border-blue-500">
            </div>
            <!-- Danh sách Tag lọc nhanh -->
            <div class="flex flex-wrap gap-1.5 mt-3">
                <template x-for="tag in tags">
                    <button @click="selectedTag = (selectedTag === tag ? '' : tag)"
                            :class="selectedTag === tag ? 'bg-blue-600 text-white' : 'bg-slate-700 text-slate-300 hover:bg-slate-600'"
                            class="text-xs px-2.5 py-1 rounded-full transition" x-text="tag"></button>
                </template>
            </div>
        </div>

        <!-- KẾT QUẢ TRA CỨU -->
        <div class="space-y-4">
            <template x-for="item in filteredDrugs" :key="item.id">
                <div class="bg-slate-800 border border-slate-700 rounded-xl p-4 shadow-md">
                    <div class="flex justify-between items-start">
                        <div>
                            <h3 class="text-lg font-bold text-blue-400" x-text="item.name"></h3>
                            <div class="flex gap-2 mt-1">
                                <span class="text-xs bg-indigo-900 text-indigo-200 px-2 py-0.5 rounded" x-text="item.category"></span>
                                <span class="text-xs bg-slate-700 text-slate-300 px-2 py-0.5 rounded" x-text="item.route"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Bảng liều lượng chi tiết -->
                    <div class="mt-3 overflow-x-auto">
                        <table class="w-full text-xs text-left border-collapse border border-slate-700">
                            <thead>
                                <tr class="bg-slate-700 text-slate-200">
                                    <th class="p-2 border border-slate-600">Nhóm / Thể</th>
                                    <th class="p-2 border border-slate-600">Cách dùng & Liều chi tiết</th>
                                </tr>
                            </thead>
                            <tbody>
                                <template x-for="row in item.details.dosage">
                                    <tr>
                                        <td class="p-2 border border-slate-700 font-medium text-blue-300" x-text="row.group"></td>
                                        <td class="p-2 border border-slate-700" x-text="row.instruction"></td>
                                    </tr>
                                </template>
                            </tbody>
                        </table>
                    </div>

                    <!-- Lưu ý lâm sàng -->
                    <div class="mt-3 text-xs bg-slate-900 p-2.5 rounded border border-slate-700/50 text-slate-300">
                        <strong class="text-amber-400">💡 Lưu ý:</strong> <span x-text="item.details.clinical_pearls"></span>
                    </div>
                </div>
            </template>
        </div>
    </main>

    <!-- FOOTER NAVIGATION BAR -->
    <nav class="bg-slate-900 border-t border-slate-800 py-3 px-6 sticky bottom-0">
        <div class="max-w-md mx-auto flex justify-between text-xs text-slate-400">
            <button class="flex flex-col items-center hover:text-blue-400"><span>📋</span>SBAR</button>
            <button class="flex flex-col items-center hover:text-blue-400"><span>🔍</span>Tiếp cận</button>
            <button class="flex flex-col items-center hover:text-blue-400"><span>⚡</span>Phác đồ</button>
            <button class="flex flex-col items-center text-blue-400 font-semibold"><span>💊</span>Thuốc</button>
            <button class="flex flex-col items-center hover:text-blue-400"><span>🧪</span>Cận lâm sàng</button>
        </div>
    </nav>

    <!-- LOGIC XỬ LÝ -->
    <script>
        function app() {
            return {
                search: '',
                selectedTag: '',
                tags: ['Cơn ngưng thở sơ sinh', 'Phản vệ', 'Tay chân miệng', 'Hen suyễn', 'Sốt xuất huyết'],
                drugs: [
                    {
                        id: 'caffeine-citrate',
                        name: 'Caffeine citrate',
                        category: 'Thuốc khác',
                        route: 'Uống/TTM',
                        tags: ['Cơn ngưng thở sơ sinh'],
                        details: {
                            dosage: [
                                { group: 'Liều tấn công', instruction: '20–40 mg/kg TTM trong 30 phút hoặc uống' },
                                { group: 'Liều duy trì', instruction: '5–10 mg/kg/ngày 1 lần, TTM trong 10 phút hoặc uống' }
                            ],
                            clinical_pearls: 'Dùng cho cơn ngưng thở ở trẻ sinh non; theo dõi nhịp tim, bú, kích thích.'
                        }
                    }
                ],
                get filteredDrugs() {
                    return this.drugs.filter(item => {
                        let matchesSearch = item.name.toLowerCase().includes(this.search.toLowerCase()) || 
                                          item.category.toLowerCase().includes(this.search.toLowerCase());
                        let matchesTag = this.selectedTag === '' || item.tags.includes(this.selectedTag);
                        return matchesSearch && matchesTag;
                    });
                }
            }
        }
    </script>
</body>
</html>
