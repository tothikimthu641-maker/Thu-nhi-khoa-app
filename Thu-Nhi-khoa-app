<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Nhi Khoa Lâm Sàng - Tra Cứu Liều PICU/NICU</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col justify-between" x-data="drugApp()">

  <!-- HEADER -->
  <header class="bg-gradient-to-r from-teal-700 via-blue-800 to-indigo-900 p-4 shadow-xl sticky top-0 z-50">
    <div class="max-w-5xl mx-auto flex justify-between items-center">
      <div class="flex items-center gap-2">
        <span class="text-yellow-400 text-2xl">🩺</span>
        <h1 class="text-xl font-extrabold text-white">Nhi Khoa Lâm Sàng - Tra Cứu Y Lệnh</h1>
      </div>
      <span class="text-xs bg-teal-900 px-3 py-1 rounded-full text-teal-200 border border-teal-400/40">v5.1 PICU Standard</span>
    </div>
  </header>

  <!-- MAIN -->
  <main class="max-w-5xl mx-auto w-full p-4 flex-1 space-y-6">

    <!-- KHU VỰC TÍNH NHANH BTĐ -->
    <section class="bg-slate-900 border border-slate-800 rounded-2xl p-5 shadow-2xl">
      <h2 class="text-lg font-bold text-amber-400 mb-4">⚡ Tính Nhanh Bơm Tiêm Điện Lâm Sàng</h2>
      
      <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1">Cân nặng bé (kg):</label>
          <input type="number" step="0.1" x-model.number="weight" class="w-full bg-slate-950 border border-slate-700 rounded-xl px-3 py-2 text-white">
        </div>
        <div class="md:col-span-2">
          <label class="block text-xs font-semibold text-slate-300 mb-1">Chọn Thuốc:</label>
          <select x-model="selectedDrugKey" @change="onDrugChange()" class="w-full bg-slate-950 border border-slate-700 rounded-xl px-3 py-2 text-white">
            <template x-for="(drug, key) in drugs" :key="key">
              <option :value="key" x-text="'[' + drug.category + '] ' + drug.name"></option>
            </template>
          </select>
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1">Thể tích pha (ml):</label>
          <input type="number" step="1" x-model.number="volume" class="w-full bg-slate-950 border border-slate-700 rounded-xl px-3 py-2 text-white">
        </div>
      </div>

      <!-- ĐIỀU CHỈNH LIỀU <-> TỐC ĐỘ -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-4 pt-4 border-t border-slate-800">
        <div class="bg-slate-950 p-3.5 rounded-xl border border-slate-800">
          <label class="block text-xs font-semibold text-blue-300 mb-1" x-text="'Liều chỉ định (' + currentDrug.unit + '):'"></label>
          <input type="number" step="0.01" x-model.number="targetDose" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-amber-400 font-bold">
          <p class="text-xs text-slate-400 mt-2">➔ Tốc độ truyền: <strong class="text-emerald-400 font-bold" x-text="calculatedRateMlH + ' ml/giờ'"></strong></p>
        </div>

        <div class="bg-slate-950 p-3.5 rounded-xl border border-slate-800">
          <label class="block text-xs font-semibold text-emerald-300 mb-1">Tự do chỉnh Tốc độ truyền (ml/giờ):</label>
          <input type="number" step="0.1" x-model.number="customRateMlH" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-emerald-400 font-bold">
          <p class="text-xs text-slate-400 mt-2">➔ Liều thực tế nhận: <strong class="text-amber-400 font-bold" x-text="calculatedActualDose + ' ' + currentDrug.unit"></strong></p>
        </div>
      </div>

      <!-- Y LỆNH MẪU -->
      <div class="mt-4 p-4 bg-amber-950/40 border border-amber-500/30 rounded-xl">
        <span class="text-xs text-slate-400 block">Hướng dẫn pha y lệnh:</span>
        <span class="text-sm font-bold text-amber-300" x-text="mixingInstructionText"></span>
      </div>
    </section>

    <!-- TRA CỨU DANH MỤC THUỐC -->
    <section class="bg-slate-900 border border-slate-800 rounded-2xl p-5 shadow-2xl">
      <div class="flex flex-col md:flex-row justify-between items-center gap-3 mb-4">
        <h2 class="text-lg font-bold text-teal-400">📚 Tra Cứu Liều Chi Tiết (TMC, TB, TTM, Liều Tối Đa & Lưu Ý)</h2>
        <input type="text" x-model="searchQuery" placeholder="Tìm tên thuốc, chỉ định..." class="w-full md:w-64 bg-slate-950 border border-slate-700 rounded-xl px-3 py-1.5 text-sm text-white">
      </div>

      <!-- LỌC NHÓM -->
      <div class="flex flex-wrap gap-1.5 mb-4">
        <template x-for="cat in categories" :key="cat.id">
          <button @click="selectedCategory = cat.id"
                  :class="selectedCategory === cat.id ? 'bg-teal-600 text-white font-bold' : 'bg-slate-950 text-slate-300 border-slate-800'"
                  class="px-3 py-1.5 rounded-lg text-xs border transition" x-text="cat.name">
          </button>
        </template>
      </div>

      <!-- THẺ THUỐC PHÂN MÀU SẮC -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 max-h-[600px] overflow-y-auto pr-1">
        <template x-for="(drug, key) in filteredDrugs" :key="key">
          <div :class="getCardStyle(drug.category)" class="border rounded-xl p-4 space-y-3 shadow-md">
            
            <div class="flex justify-between items-start border-b border-white/10 pb-2">
              <div>
                <h3 class="text-base font-extrabold text-white" x-text="drug.name"></h3>
                <p class="text-xs opacity-80" x-text="'Hàm lượng: ' + drug.concentration"></p>
              </div>
              <span class="text-[10px] px-2.5 py-0.5 rounded-full font-bold uppercase" :class="getBadgeStyle(drug.category)" x-text="drug.category"></span>
            </div>

            <!-- LIỀU TỪNG ĐƯỜNG DÙNG -->
            <div class="space-y-1.5 text-xs bg-slate-950/60 p-3 rounded-lg border border-white/5">
              <p class="font-bold text-amber-300 text-[11px] uppercase">📌 Liều dùng theo đường dùng:</p>
              
              <template x-if="drug.doseTMC">
                <p><span class="bg-cyan-950 text-cyan-300 font-bold px-1 py-0.5 rounded text-[10px] border border-cyan-800">TMC</span> <span x-text="drug.doseTMC"></span></p>
              </template>

              <template x-if="drug.doseTB">
                <p><span class="bg-purple-950 text-purple-300 font-bold px-1 py-0.5 rounded text-[10px] border border-purple-800">TB</span> <span x-text="drug.doseTB"></span></p>
              </template>

              <template x-if="drug.doseTTM">
                <p><span class="bg-emerald-950 text-emerald-300 font-bold px-1 py-0.5 rounded text-[10px] border border-emerald-800">TTM</span> <span x-text="drug.doseTTM"></span></p>
              </template>
            </div>

            <!-- LIỀU TỐI ĐA & LƯU Ý -->
            <div class="text-xs space-y-1.5">
              <p><strong class="opacity-70">Chỉ định:</strong> <span x-text="drug.indication"></span></p>
              <div class="bg-red-950/40 border border-red-500/30 p-2 rounded text-red-200">
                <strong>🛑 Liều tối đa:</strong> <span x-text="drug.maxDose"></span>
              </div>
              <div class="bg-amber-950/40 border border-amber-500/30 p-2 rounded text-amber-200">
                <strong>⚠️ Lưu ý:</strong> <span x-text="drug.note"></span>
              </div>
            </div>

            <button @click="selectDrugForCalc(key)" class="w-full bg-white/10 hover:bg-white/20 text-white text-xs py-1.5 rounded-lg border border-white/20 font-semibold transition">
              ⚡ Chọn tính nhanh liều này
            </button>
          </div>
        </template>
      </div>
    </section>

  </main>

  <!-- FOOTER -->
  <footer class="bg-slate-950 p-4 border-t border-slate-800 text-center text-xs text-slate-500">
    Nhi Khoa Lâm Sàng - PICU/NICU Toolkit
  </footer>

  <!-- SCRIPT ALPNEJS -->
  <script>
    function drugApp() {
      return {
        weight: 10,
        volume: 50,
        targetDose: 0.1,
        customRateMlH: 1.0,
        selectedDrugKey: 'adrenalin',
        selectedCategory: 'all',
        searchQuery: '',

        categories: [
          { id: 'all', name: 'Tất cả' },
          { id: 'Vận mạch', name: 'Vận mạch' },
          { id: 'Kháng sinh', name: 'Kháng sinh' },
          { id: 'Giãn cơ - An thần', name: 'Giãn cơ - An thần' },
          { id: 'Hô hấp / Khí dung', name: 'Hô hấp / Khí dung' },
          { id: 'Điện giải & Khác', name: 'Điện giải & Khác' }
        ],

        getCardStyle(category) {
          if (category === 'Vận mạch') return 'bg-rose-950/20 border-rose-500/40';
          if (category === 'Kháng sinh') return 'bg-sky-950/20 border-sky-500/40';
          if (category === 'Giãn cơ - An thần') return 'bg-purple-950/20 border-purple-500/40';
          if (category === 'Hô hấp / Khí dung') return 'bg-emerald-950/20 border-emerald-500/40';
          return 'bg-amber-950/20 border-amber-500/40';
        },

        getBadgeStyle(category) {
          if (category === 'Vận mạch') return 'bg-rose-900 text-rose-200 border border-rose-700';
          if (category === 'Kháng sinh') return 'bg-sky-900 text-sky-200 border border-sky-700';
          if (category === 'Giãn cơ - An thần') return 'bg-purple-900 text-purple-200 border border-purple-700';
          if (category === 'Hô hấp / Khí dung') return 'bg-emerald-900 text-emerald-200 border border-emerald-700';
          return 'bg-amber-900 text-amber-200 border border-amber-700';
        },

        drugs: {
          adrenalin: {
            name: "Adrenalin (Epinephrine)",
            concentration: "1mg/1ml",
            category: "Vận mạch",
            unit: "mcg/kg/phút",
            defaultDose: 0.1,
            doseTMC: "Ngừng tuần hoàn / Phản vệ nặng: 0.01 mg/kg (0.01 ml/kg dung dịch 1:1000).",
            doseTB: "Phản vệ: Tiêm bắp 0.01 mg/kg (Tối đa 0.5mg/liều).",
            doseTTM: "Truyền liên tục: 0.05 - 1.0 mcg/kg/phút qua BTĐ.",
            maxDose: "Duy trì theo đáp ứng huyết áp lâm sàng.",
            indication: "Phản vệ, Ngừng tuần hoàn, Sốc tim, Sốc nhiễm khuẩn.",
            note: "Tránh tiêm tĩnh mạch nhanh dung dịch đậm đặc ngoài cấp cứu ngừng tuần hoàn.",
            diluent: "D5W hoặc NS"
          },
          noradrenalin: {
            name: "Noradrenaline",
            concentration: "4mg/4ml",
            category: "Vận mạch",
            unit: "mcg/kg/phút",
            defaultDose: 0.1,
            doseTMC: "Không dùng tiêm mạch chậm.",
            doseTB: "Tuyệt đối KHÔNG tiêm bắp (gây hoại tử mô).",
            doseTTM: "Truyền liên tục: 0.05 - 1.0 mcg/kg/phút.",
            maxDose: "Tối đa 2 - 3 mcg/kg/phút trong sốc kháng trị.",
            indication: "Sốc nhiễm khuẩn, Sốc phân bố.",
            note: "Nên truyền qua đường tĩnh mạch trung tâm.",
            diluent: "D5W"
          },
          furosemide: {
            name: "Furosemide",
            concentration: "40mg/4ml",
            category: "Vận mạch",
            unit: "mg/giờ",
            defaultDose: 1.0,
            doseTMC: "Tiêm mạch chậm 1-2 phút: 1 - 2 mg/kg/liều.",
            doseTB: "Tiêm bắp: 1 - 2 mg/kg/liều.",
            doseTTM: "Truyền liên tục: 0.1 - 1 mg/kg/giờ.",
            maxDose: "Liều đơn tối đa 10 mg/kg hoặc 6 mg/kg/ngày.",
            indication: "Phù phổi cấp, quá tải dịch, suy tim cấp.",
            note: "Tiêm quá nhanh có thể gây ù tai thoáng qua.",
            diluent: "NS hoặc D5W"
          },
          vancomycin: {
            name: "Vancomycin",
            concentration: "500mg, 1g",
            category: "Kháng sinh",
            unit: "mg/kg/liều",
            defaultDose: 15.0,
            doseTMC: "Không tiêm mạch chậm (nguy cơ hội chứng Red man).",
            doseTB: "Không tiêm bắp.",
            doseTTM: "Truyền tĩnh mạch chậm > 60 phút: 10 - 15 mg/kg/liều mỗi 6-8 giờ.",
            maxDose: "60 mg/kg/ngày (hoặc tối đa 2g/ngày).",
            indication: "Nhiễm trùng Gram dương kháng thuốc (MRSA).",
            note: "Pha loãng nồng độ <= 5 mg/ml trước khi truyền.",
            diluent: "NS hoặc D5W"
          },
          meropenem: {
            name: "Meropenem",
            concentration: "500mg, 1g",
            category: "Kháng sinh",
            unit: "mg/kg/liều",
            defaultDose: 20.0,
            doseTMC: "Tiêm mạch chậm 3-5 phút: 20 - 40 mg/kg/liều.",
            doseTB: "Không khuyến cáo tiêm bắp.",
            doseTTM: "Truyền tĩnh mạch kéo dài (3 giờ): 20 - 40 mg/kg mỗi 8 giờ.",
            maxDose: "2g / liều.",
            indication: "Nhiễm trùng bệnh viện nặng, viêm màng não mủ.",
            note: "Dùng ngay sau khi pha.",
            diluent: "NS hoặc D5W"
          },
          diazepam: {
            name: "Diazepam",
            concentration: "10mg/2ml",
            category: "Giãn cơ - An thần",
            unit: "mg/kg/liều",
            defaultDose: 0.2,
            doseTMC: "Tiêm mạch chậm: 0.2 - 0.3 mg/kg/liều.",
            doseTB: "Không tiêm bắp (hấp thu thất thường).",
            doseTTM: "Không khuyến cáo truyền kéo dài.",
            maxDose: "10mg / liều đơn.",
            indication: "Cắt cơn động kinh cấp.",
            note: "Theo dõi sát hô hấp, chuẩn bị sẵn bóng bóp.",
            diluent: "Không pha loãng hoặc pha NS"
          },
          midazolam: {
            name: "Midazolam",
            concentration: "5mg/ml",
            category: "Giãn cơ - An thần",
            unit: "mcg/kg/phút",
            defaultDose: 1.0,
            doseTMC: "Tiêm mạch chậm: 0.05 - 0.2 mg/kg.",
            doseTB: "Tiêm bắp: 0.1 - 0.15 mg/kg.",
            doseTTM: "Truyền liên tục: 1 - 5 mcg/kg/phút.",
            maxDose: "Tối đa 10 mcg/kg/phút.",
            indication: "An thần thở máy, động kinh trạng thái.",
            note: "Theo dõi sát SpO2.",
            diluent: "NS hoặc D5W"
          },
          calcium_gluconat: {
            name: "Calcium Gluconate 10%",
            concentration: "1g/10ml",
            category: "Điện giải & Khác",
            unit: "ml/kg/liều",
            defaultDose: 0.5,
            doseTMC: "Tiêm mạch rất chậm > 10 phút: 0.5 - 1 ml/kg/liều.",
            doseTB: "Tuyệt đối KHÔNG tiêm bắp (hoại tử mô nặng).",
            doseTTM: "Truyền tĩnh mạch pha loãng.",
            maxDose: "20ml / liều đơn.",
            indication: "Hạ canxi máu, tăng Kali máu.",
            note: "Ngừng ngay nếu nhịp tim chậm trên ECG.",
            diluent: "D5W"
          },
          morphin: {
            name: "Morphin HCl 0,01g/ml Ống 1 ml",
            concentration: "10mg/1ml (0.01g/1ml)",
            category: "Giãn cơ - An thần",
            unit: "mg/kg/giờ",
            defaultDose: 0.05,
            doseTMC: "Tiêm mạch chậm: 0,05 - 0,1 mg/kg/liều (Pha loãng và tiêm chậm từ 3 - 5 phút).",
            doseTB: "Tiêm bắp / Tiêm dưới da: 0,1 - 0,2 mg/kg/liều (khi không có đường tĩnh mạch).",
            doseTTM: "Tấn công: 0,1 - 0,2 mg/kg. Truyền tĩnh mạch duy trì: 10 - 30 mcg/kg/giờ (hoặc 0,01 - 0,04 mg/kg/giờ).",
            maxDose: "Tối đa 0,1 - 0,2 mg/kg/liều đơn hoặc không vượt quá 10 mg/liều ở trẻ lớn.",
            indication: "Giảm đau - An thần (Opioid), an thần thở máy, suy hô hấp cấp nặng / phù phổi.",
            note: "Dễ gây ức chế hô hấp, hạ huyết áp, co đồng tử, táo bón; cần sẵn sàng Naloxone và phương tiện hỗ trợ hô hấp.",
            diluent: "D5W hoặc NS (Pha loãng trước khi tiêm/truyền)"
          },
        },

        get currentDrug() {
          return this.drugs[this.selectedDrugKey] || this.drugs['adrenalin'];
        },

        onDrugChange() {
          this.targetDose = this.currentDrug.defaultDose;
        },

        selectDrugForCalc(key) {
          this.selectedDrugKey = key;
          this.targetDose = this.currentDrug.defaultDose;
          window.scrollTo({ top: 0, behavior: 'smooth' });
        },

        get calculatedMg() {
          if (!this.weight || !this.targetDose) return "0";
          let mg = (this.targetDose * this.weight * 60 * this.volume) / 1000;
          return mg.toFixed(2);
        },

        get calculatedRateMlH() {
          return "1.0";
        },

        get calculatedActualDose() {
          if (!this.weight || !this.volume) return "0";
          let mgTotal = parseFloat(this.calculatedMg);
          let mgPerMl = mgTotal / this.volume;
          let actual = (mgPerMl * this.customRateMlH * 1000) / (this.weight * 60);
          return actual.toFixed(2);
        },

        get mixingInstructionText() {
          return `Lấy ${this.calculatedMg} mg ${this.currentDrug.name} + ${this.currentDrug.diluent} vừa đủ ${this.volume} ml (Duy trì 1 ml/giờ).`;
        },

        get filteredDrugs() {
          let q = this.searchQuery.toLowerCase().trim();
          let cat = this.selectedCategory;
          let res = {};
          for (let k in this.drugs) {
            let d = this.drugs[k];
            if ((cat === 'all' || d.category === cat) &&
                (!q || d.name.toLowerCase().includes(q) || d.indication.toLowerCase().includes(q))) {
              res[k] = d;
            }
          }
          return res;
        }
      }
    }
  </script>
</body>
</html>
